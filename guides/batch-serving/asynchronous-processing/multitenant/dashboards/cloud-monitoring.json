{
  "displayName": "LLM-D Async Processor",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Request rate by team (req/s)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (pool_name) (rate(llm_d_async_async_request_total[5m]))"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.pool_name}"
              }
            ],
            "yAxis": {
              "label": "req/s",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Successful request rate by team (req/s)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (pool_name) (rate(llm_d_async_async_successful_requests_total[5m]))"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.pool_name}"
              }
            ],
            "yAxis": {
              "label": "req/s",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "In-flight requests by pool (quota effect)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (pool_name) (llm_d_async_async_inflight_requests)"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.pool_name}"
              }
            ],
            "yAxis": {
              "label": "in-flight",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Message latency p95 by team (ms)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, pool_name) (rate(llm_d_async_async_message_latency_time_millis_bucket[5m])))"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.pool_name}"
              }
            ],
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Broker backlog by queue",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (queue_name) (llm_d_async_async_broker_backlog)"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.queue_name}"
              }
            ],
            "yAxis": {
              "label": "backlog",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "In-process queue depth by queue",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (queue_name) (llm_d_async_async_queue_depth)"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.queue_name}"
              }
            ],
            "yAxis": {
              "label": "queue depth",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 12,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Dispatch budget by team (gate openness 0\u20131)  [#290]",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "max by (pool_name) (llm_d_async_async_dispatch_budget)"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.pool_name}"
              }
            ],
            "yAxis": {
              "label": "budget",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 12,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Gate decisions by reason (per sec)  [#291]",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (reason) (rate(llm_d_async_async_gate_decisions_total[5m]))"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.reason}"
              }
            ],
            "yAxis": {
              "label": "decisions/s",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 16,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Worker utilization by pool (in-flight \u00f7 limit)  [#290]",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (pool_name)(llm_d_async_async_inflight_requests) / sum by (pool_name)(llm_d_async_async_pool_worker_limit)"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.pool_name}"
              }
            ],
            "yAxis": {
              "label": "utilization",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 16,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Gate decisions by team & reason (per sec)  [#291]",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (pool_name, reason) (rate(llm_d_async_async_gate_decisions_total[5m]))"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.pool_name} \u00b7 ${metric.labels.reason}"
              }
            ],
            "yAxis": {
              "label": "decisions/s",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 20,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Exceeded deadline request rate (req/s)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (pool_name) (rate(llm_d_async_async_exceeded_deadline_requests_total[5m]))"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.pool_name}"
              }
            ],
            "yAxis": {
              "label": "req/s",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 20,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Token processing rate by pool & direction (tokens/s)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (pool_name, direction) (rate(llm_d_async_async_tokens_total[5m]))"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.pool_name} \u00b7 ${metric.labels.direction}"
              }
            ],
            "yAxis": {
              "label": "tokens/s",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 24,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Deadline proximity by queue (p10 / p50 / p90 / p99) (s)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.10, sum by (le, queue_name) (llm_d_async_async_deadline_proximity_millis_bucket)) / 1000",
                  "unitOverride": "s"
                },
                "plotType": "LINE",
                "legendTemplate": "p10 · ${metric.labels.queue_name}"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.50, sum by (le, queue_name) (llm_d_async_async_deadline_proximity_millis_bucket)) / 1000",
                  "unitOverride": "s"
                },
                "plotType": "LINE",
                "legendTemplate": "p50 · ${metric.labels.queue_name}"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.90, sum by (le, queue_name) (llm_d_async_async_deadline_proximity_millis_bucket)) / 1000",
                  "unitOverride": "s"
                },
                "plotType": "LINE",
                "legendTemplate": "p90 · ${metric.labels.queue_name}"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (le, queue_name) (llm_d_async_async_deadline_proximity_millis_bucket)) / 1000",
                  "unitOverride": "s"
                },
                "plotType": "LINE",
                "legendTemplate": "p99 · ${metric.labels.queue_name}"
              }
            ],
            "yAxis": {
              "label": "s",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 24,
        "width": 6,
        "height": 4,
        "widget": {
          "text": {
            "content": "**Note:** Deadline proximity (`llm_d_async_async_deadline_proximity_millis`) only works when Redis Sorted Set queues are used (`--transport=redis-sortedset`). Cloud Pub/Sub cannot expose per-item deadlines.\n\n*Scrape Semantics:* This metric is a snapshot histogram of queued items rebuilt per poll from Redis `ZCOUNT`. Because it is not monotonic, do not use `rate()`. Evaluates to `NaN` when queues are empty.",
            "format": "MARKDOWN"
          }
        }
      }
    ]
  }
}
