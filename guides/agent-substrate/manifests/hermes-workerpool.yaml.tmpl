# GKE Agent Substrate WorkerPool for 1,000 Hermes Agent sandboxes.
#
# Sizing notes (validated on 18 x c4d-standard-16 nodes = ~56 agents/node):
#   - `HERMES_WORKER_REPLICAS=1080` (60 workers x 18 nodes) leaves ~4 spare
#     workers per node while keeping every paused agent's ~150 MiB node-local
#     snapshot warm.
#   - `limits.memory: 1536Mi` covers the ~180 MiB Hermes RSS, gVisor sentry, and
#     the ~150 MiB checkpoint page cache charged during pause.
#   - `requests.memory: 880Mi` evenly spreads ~60 workers per 64 GiB node
#     without needing topologySpreadConstraints on WorkerPool.
apiVersion: v1
kind: Namespace
metadata:
  name: agent-hermes
---
apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: hermes-workerpool
  namespace: agent-hermes
  labels:
    workload: hermes
    llm-d.ai/guide: agent-substrate
spec:
  replicas: ${HERMES_WORKER_REPLICAS}
  sandboxClass: gvisor
  workerImage: ${SUBSTRATE_WORKER_IMAGE}
  template:
    nodeSelector:
      ate.dev/substrate-version: "${SUBSTRATE_VERSION}"
      pool: hermes
    tolerations:
      - key: ate.dev/sandboxClass
        operator: Equal
        value: hermes
        effect: NoSchedule
    resources:
      limits:
        cpu: "1"
        memory: 1536Mi
      requests:
        cpu: 10m
        memory: 880Mi
