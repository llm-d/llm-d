  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 3,
      "type": "table",
      "title": "Fairness IDs",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 24,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "description": "One row per fairness ID: a tenant or a session, depending on what sets it. Values are totals since the EPP started counting the fairness ID, for fairness IDs with requests in the time range. They come from the EPP request metrics, summed over EPP pods. TTFT is measured at the EPP, from request received to first response byte. Uncached tokens are prompt tokens minus cached tokens: the prompt the model server had to prefill. Cached tokens are reported only when the model server returns them (vLLM: --enable-prompt-tokens-details); otherwise the uncached and cached share columns are empty. The row \"other (over label limit)\" appears when the EPP reached --fairness-id-metric-label-limit; it holds the requests of every fairness ID after the limit. The row \"default-flow (no fairness ID)\" holds requests that carried no fairness ID.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (fairness_id) (last_over_time(llm_d_epp_request_total{namespace=~\"$namespace\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (fairness_id) (last_over_time(llm_d_epp_request_ttft_seconds_sum{namespace=~\"$namespace\"}[$__range])) / sum by (fairness_id) (last_over_time(llm_d_epp_request_ttft_seconds_count{namespace=~\"$namespace\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.9, sum by (fairness_id, le) (last_over_time(llm_d_epp_request_ttft_seconds_bucket{namespace=~\"$namespace\"}[$__range])))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (fairness_id) (last_over_time(llm_d_epp_request_input_tokens_sum{namespace=~\"$namespace\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (fairness_id) (last_over_time(llm_d_epp_request_input_tokens_sum{namespace=~\"$namespace\"}[$__range])) - sum by (fairness_id) (last_over_time(llm_d_epp_request_cached_tokens_sum{namespace=~\"$namespace\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (fairness_id) (last_over_time(llm_d_epp_request_cached_tokens_sum{namespace=~\"$namespace\"}[$__range])) / sum by (fairness_id) (last_over_time(llm_d_epp_request_input_tokens_sum{namespace=~\"$namespace\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (fairness_id) (last_over_time(llm_d_epp_request_error_total{namespace=~\"$namespace\"}[$__range])) or (sum by (fairness_id) (last_over_time(llm_d_epp_request_total{namespace=~\"$namespace\"}[$__range])) * 0)",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "fairness_id": "Fairness ID",
              "Value #A": "Requests",
              "Value #B": "Mean TTFT",
              "Value #C": "p90 TTFT",
              "Value #D": "Prompt tokens",
              "Value #E": "Uncached tokens",
              "Value #F": "Cached share",
              "Value #G": "Errors"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
