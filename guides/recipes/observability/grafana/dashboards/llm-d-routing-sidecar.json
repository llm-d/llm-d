        "name": "namespace",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(llm_d_disagg_sidecar_decode_duration_seconds_count, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
