        },
        "definition": "label_values(llm_d_disagg_sidecar_decode_duration_seconds_count{namespace=~\"$namespace\"}, pod)",
        "includeAll": true,
        "label": "pod",
        "multi": true,
        "name": "pod",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(llm_d_disagg_sidecar_decode_duration_seconds_count{namespace=~\"$namespace\"}, pod)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
