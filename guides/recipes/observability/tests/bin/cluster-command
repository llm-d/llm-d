#!/usr/bin/env bash

set -euo pipefail

: "${STUB_LOG:?STUB_LOG must be set}"
: "${STUB_MUTATIONS:?STUB_MUTATIONS must be set}"

command_name="${STUB_COMMAND:?STUB_COMMAND must be set}"
arguments=""
for argument in "$@"; do
  arguments+="[$argument]"
done
printf 'command=%s kubeconfig=[%s] args=%s\n' \
  "$command_name" "${KUBECONFIG-<unset>}" "$arguments" >> "$STUB_LOG"

record_mutation() {
  printf 'command=%s kubeconfig=[%s] args=%s\n' \
    "$command_name" "${KUBECONFIG-<unset>}" "$arguments" >> "$STUB_MUTATIONS"
}

# install-otel-collector-loki.sh. Namespaces listed in STUB_EXISTING_NAMESPACES
# exist. STUB_ENFORCE_LEVEL and STUB_CREATED_BY are the Pod Security label and
# created-by annotation every namespace reports. STUB_COLLECTED_NAMESPACES is
# what a running agent collects; unset means no agent is deployed yet.
if [[ "$command_name" == kubectl && "${STUB_MODE:-}" == logs ]]; then
  case "$1" in
    create|annotate|label|apply|set|delete)
      record_mutation
      ;;
    rollout)
      if [[ "${3:-}" == daemonset/* ]]; then
        exit "${STUB_AGENT_ROLLOUT_STATUS:-0}"
      fi
      ;;
    describe)
      printf 'Events:\n  Warning  FailedCreate  daemonset-controller  violates PodSecurity "baseline:latest"\n'
      ;;
    get)
      case "${2:-}" in
        clusterversion)
          [[ -n "${STUB_OPENSHIFT:-}" ]] || exit 1
          ;;
        nodes)
          printf '%s' "${STUB_NODE_NAME:-kind-worker}"
          ;;
        namespace)
          [[ " ${STUB_EXISTING_NAMESPACES:-} " == *" ${3:-} "* ]] || exit 1
          case "$*" in
            *enforce*) printf '%s' "${STUB_ENFORCE_LEVEL:-}" ;;
            *created-by*) printf '%s' "${STUB_CREATED_BY:-}" ;;
          esac
          ;;
        daemonset)
          [[ -n "${STUB_COLLECTED_NAMESPACES+set}" ]] || exit 1
          printf '%s' "$STUB_COLLECTED_NAMESPACES"
          ;;
      esac
      ;;
  esac
  exit 0
fi

case "$command_name:$1" in
  kubectl:cluster-info)
    if [[ "${STUB_MODE:-}" == selected-fails && "${KUBECONFIG:-}" == "${SELECTED_KUBECONFIG:-}" ]]; then
      exit 1
    fi
    ;;
  kubectl:get)
    case "${2:-}" in
      clusterversion|crd)
        exit 1
        ;;
      namespace)
        [[ "${STUB_MODE:-}" == tls ]] && exit 0
        ;;
      secret|configmap)
        exit 1
        ;;
      svc)
        # jaeger-collector lookups. STUB_JAEGER_NAMESPACES lists the namespaces
        # holding one, space-separated; unset means tracing is not installed.
        if [[ "${3:-}" == --all-namespaces ]]; then
          printf '%s' "${STUB_JAEGER_NAMESPACES:-}"
          exit 0
        fi
        for namespace in ${STUB_JAEGER_NAMESPACES:-}; do
          [[ " $* " == *" -n ${namespace} "* ]] && exit 0
        done
        exit 1
        ;;
    esac
    ;;
  kubectl:create|kubectl:apply|kubectl:delete|helm:install|helm:upgrade|helm:uninstall|oc:create)
    record_mutation
    # Read a piped manifest like kubectl does. Exiting first breaks the pipe
    # under the installer's pipefail and randomly aborts the install.
    if [[ " $* " == *" -f - "* ]]; then
      cat >/dev/null
    fi
    ;;
esac

if [[ "$command_name" == helm && "${1:-}" == repo && "${2:-}" == list ]]; then
  printf '%s\n' 'prometheus-community https://prometheus-community.github.io/helm-charts'
fi

# The installer deletes its values file once helm returns, so keep a copy of
# exactly what helm was given.
if [[ "$command_name" == helm && -n "${STUB_CAPTURE_VALUES:-}" ]]; then
  previous=""
  for argument in "$@"; do
    if [[ "$previous" == -f && -f "$argument" ]]; then
      cp "$argument" "$STUB_CAPTURE_VALUES"
    fi
    previous="$argument"
  done
fi

# An existing release: STUB_RELEASE_CHART_VERSION makes helm list report it and
# STUB_RELEASE_VALUES names a file helm get values prints.
if [[ "$command_name" == helm && "${1:-}" == list && -n "${STUB_RELEASE_CHART_VERSION:-}" ]]; then
  if [[ " $* " == *" -o json "* ]]; then
    printf '[{"name":"llmd","chart":"kube-prometheus-stack-%s"}]\n' "$STUB_RELEASE_CHART_VERSION"
  else
    printf 'llmd\tllm-d-monitoring\t1\tdeployed\tkube-prometheus-stack-%s\n' "$STUB_RELEASE_CHART_VERSION"
  fi
fi

if [[ "$command_name" == helm && "${1:-}" == get && "${2:-}" == values && -n "${STUB_RELEASE_VALUES:-}" ]]; then
  cat "$STUB_RELEASE_VALUES"
fi

if [[ "$command_name" == helm && "${1:-}" == show && "${2:-}" == crds ]]; then
  printf '%s\n' 'apiVersion: apiextensions.k8s.io/v1'
fi
