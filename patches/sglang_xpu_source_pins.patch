diff --git a/docker/xpu.Dockerfile b/docker/xpu.Dockerfile
--- a/docker/xpu.Dockerfile
+++ b/docker/xpu.Dockerfile
@@ -11,9 +11,10 @@

 ARG SG_LANG_REPO=https://github.com/sgl-project/sglang.git
 ARG SG_LANG_BRANCH=main
+ARG SG_LANG_COMMIT=

-ARG SG_LANG_KERNEL_REPO=https://github.com/sgl-project/sgl-kernel-xpu.git
-ARG SG_LANG_KERNEL_BRANCH=main
+ARG SG_LANG_KERNEL_REPO=
+ARG SG_LANG_KERNEL_BRANCH=

 USER root

@@ -76,10 +77,26 @@
 RUN pip install --no-cache-dir torch==2.13.0+xpu torchvision==0.28.0+xpu torchaudio==2.11.0+xpu --index-url https://download.pytorch.org/whl/xpu && \
     pip install --no-cache-dir msgspec blake3 py-cpuinfo compressed_tensors gguf partial_json_parser einops tabulate --root-user-action=ignore

-RUN echo "Cloning ${SG_LANG_BRANCH} from ${SG_LANG_REPO}" && \
-    git clone --branch ${SG_LANG_BRANCH} --single-branch ${SG_LANG_REPO} sglang && \
+RUN echo "Cloning ${SG_LANG_REPO} at ${SG_LANG_COMMIT:-${SG_LANG_BRANCH}}" && \
+    git clone ${SG_LANG_REPO} sglang && \
     git -C sglang fetch --tags --force origin && \
-    cd sglang && cd python && \
+    cd sglang && \
+    if [ -n "${SG_LANG_COMMIT}" ]; then \
+        git checkout --detach "${SG_LANG_COMMIT}" && \
+        test "$(git rev-parse HEAD)" = "${SG_LANG_COMMIT}"; \
+    else \
+        git checkout "${SG_LANG_BRANCH}"; \
+    fi && \
+    cd python && \
+    if [ -n "${SG_LANG_KERNEL_REPO}" ] || [ -n "${SG_LANG_KERNEL_BRANCH}" ]; then \
+        if [ -z "${SG_LANG_KERNEL_REPO}" ] || [ -z "${SG_LANG_KERNEL_BRANCH}" ]; then \
+            echo "Kernel override requires both SG_LANG_KERNEL_REPO and SG_LANG_KERNEL_BRANCH" >&2; \
+            exit 1; \
+        fi; \
+        grep -Fq '"sglang-kernel-xpu @ ' pyproject_xpu.toml && \
+        sed -i "s|sglang-kernel-xpu @ [^\"]*|sglang-kernel-xpu @ git+${SG_LANG_KERNEL_REPO}@${SG_LANG_KERNEL_BRANCH}|" pyproject_xpu.toml && \
+        grep -Fq "sglang-kernel-xpu @ git+${SG_LANG_KERNEL_REPO}@${SG_LANG_KERNEL_BRANCH}" pyproject_xpu.toml; \
+    fi && \
     cp pyproject_xpu.toml pyproject.toml && \
     pip install --no-cache-dir ".[dev,diffusion]" --extra-index-url https://download.pytorch.org/whl/xpu && \
     pip install --no-cache-dir --no-deps xgrammar==0.1.33
