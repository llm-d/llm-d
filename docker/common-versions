# ============================================================================
# vLLM Version Configuration
# ============================================================================
# Used by CPU platforms
VLLM_REPO=https://github.com/vllm-project/vllm.git
VLLM_COMMIT_SHA=ced6857afa0ea7b2e3f0846a62e1394e90f15607 # v0.30.0 release

# Used by XPU: official prebuilt vLLM XPU image from Docker Hub.
# The XPU image is a thin pass-through over this base; switch tags here to upgrade.
# Official vLLM v0.30.0 release image.
VLLM_XPU_BASE_IMAGE=vllm/vllm-openai-xpu:v0.30.0

# ============================================================================
# SGLang XPU Version Configuration
# ============================================================================
# GitHub owner/repo and pinned revision used for the SGLang XPU source checkout.
SGLANG_XPU_REPOSITORY=sgl-project/sglang
SGLANG_XPU_REF=94602c9c2b7cbdb8efd5c52802dac6a1c180089e # v0.5.20 release

# SGLang v0.5.20 defaults to its prebuilt sglang-kernel-xpu v0.2.0 wheel.
# Optional source override: set BOTH values, or leave both unset/empty.
# SGLANG_XPU_KERNEL_REPO=https://github.com/sgl-project/sgl-kernel-xpu.git
# SGLANG_XPU_KERNEL_REF=5b33313d231f10ec061ccbabdcaea51354dc5acd # v0.2.0
